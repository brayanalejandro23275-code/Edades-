<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Actividad 4 - Fecha completa</title>
<style>
  body{
    font-family: 'Segoe UI', Arial, sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .contenedor{
    background: white;
    padding: 30px;
    border-radius: 20px;
    width: 380px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    text-align: center;
  }
  .creador{
    margin-top: 0;
    font-weight: bold;
    color: #764ba2;
    font-size: 14px;
    letter-spacing: 1px;
  }
  h2{
    color: #333;
    margin: 10px 0 20px 0;
  }
  input{
    padding: 12px;
    margin: 6px 3px;
    border-radius: 10px;
    border: 2px solid #e0e0e0;
    outline: none;
    transition: 0.3s;
    font-size: 14px;
  }
  input:focus{
    border-color: #667eea;
    box-shadow: 0 0 5px rgba(102,126,234,0.3);
  }
  #nombre{
    width: 90%;
  }
  button{
    width: 95%;
    padding: 13px;
    margin-top: 15px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
  }
  button:hover{
    transform: scale(1.03);
    box-shadow: 0 5px 15px rgba(102,126,234,0.4);
  }
  #respuesta{
    margin-top: 20px;
    font-size: 17px;
    min-height: 25px;
  }
  #fecha{
    color: #666;
    font-size: 14px;
    margin-top: 5px;
  }
</style>
</head>
<body>

<div class="contenedor">
  <p class="creador">Creado por: Brayan</p>

  <h2>Mini sistema con fecha completa</h2>
  
  <input type="text" id="nombre" placeholder="Tu nombre"><br>
  <input type="number" id="dia" placeholder="Día (1-31)" style="width:90px">
  <input type="number" id="mes" placeholder="Mes (1-12)" style="width:90px">
  <input type="number" id="anio" placeholder="Año (ej: 2008)" style="width:110px">
  <br>
  <button onclick="verificar()">Verificar</button>

  <h3 id="respuesta"></h3>
  <p id="fecha"></p>
</div>

<script>
function verificar(){
  let nombre = document.getElementById("nombre").value.trim();
  let diaStr = document.getElementById("dia").value.trim();
  let mesStr = document.getElementById("mes").value.trim();
  let anioStr = document.getElementById("anio").value.trim();

  // VALIDACIÓN 1: Campos vacíos
  if(nombre == "" || diaStr == "" || mesStr == "" || anioStr == ""){
    document.getElementById("respuesta").innerHTML = "⚠️ Llena todos los campos";
    document.getElementById("respuesta").style.color = "orange";
    document.getElementById("fecha").innerHTML = "";
    return;
  }

  let dia = Number(diaStr);
  let mes = Number(mesStr);
  let anio = Number(anioStr);

  // VALIDACIÓN 2: Nombre solo letras
  if(!/^[A-Za-zÁÉÍÓÚáéíóúñÑ ]{3,}$/.test(nombre)){
    document.getElementById("respuesta").innerHTML = "❌ Nombre no válido, solo letras";
    document.getElementById("respuesta").style.color = "red";
    document.getElementById("fecha").innerHTML = "";
    return;
  }

  // VALIDACIÓN 3: Rangos
  if(mes < 1 || mes > 12 || dia < 1 || dia > 31 || anio < 1900 || anio > 2026){
    document.getElementById("respuesta").innerHTML = "❌ Fecha no válida, revisa día, mes y año";
    document.getElementById("respuesta").style.color = "red";
    document.getElementById("fecha").innerHTML = "";
    return;
  }

  // VALIDACIÓN 4: Que la fecha exista (31 feb no existe)
  let nacimiento = new Date(anio, mes - 1, dia);
  if(nacimiento.getFullYear() != anio || nacimiento.getMonth() != mes - 1 || nacimiento.getDate() != dia){
    document.getElementById("respuesta").innerHTML = "❌ Esa fecha no existe";
    document.getElementById("respuesta").style.color = "red";
    document.getElementById("fecha").innerHTML = "";
    return;
  }

  // VALIDACIÓN 5: Que no sea futuro
  let hoy = new Date();
  hoy.setHours(0,0,0,0);
  if(nacimiento > hoy){
    document.getElementById("respuesta").innerHTML = "❌ No puedes nacer en el futuro";
    document.getElementById("respuesta").style.color = "red";
    document.getElementById("fecha").innerHTML = "";
    return;
  }

  // Si todo está bien
  let edad = hoy.getFullYear() - nacimiento.getFullYear();
  let diferenciaMes = hoy.getMonth() - nacimiento.getMonth();
  if(diferenciaMes < 0 || (diferenciaMes == 0 && hoy.getDate() < nacimiento.getDate())){
    edad--;
  }

  document.getElementById("fecha").innerHTML = "Tu fecha de nacimiento es: " + dia + "/" + mes + "/" + anio;

  if(edad >= 18){
    document.getElementById("respuesta").innerHTML = "✅ Bienvenido " + nombre + ", tienes " + edad + " años, puedes entrar";
    document.getElementById("respuesta").style.color = "green";
  } else {
    document.getElementById("respuesta").innerHTML = "⛔ Lo siento " + nombre + ", tienes " + edad + " años, eres menor";
    document.getElementById("respuesta").style.color = "red";
  }
}
</script>

</body>
</html>1
